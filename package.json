{
  "name": "pi-tiny-fork",
  "version": "0.1.0",
  "description": "Fresh Pi child sessions and tracked script runs",
  "type": "module",
  "keywords": ["pi-package"],
  "license": "MIT",
  "files": ["README.md", "extensions", "src", "bin", "examples"],
  "bin": {
    "pi-child": "./bin/pi-child.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spoj/pi-tiny-fork.git"
  },
  "pi": {
    "extensions": ["./extensions/fork.ts", "./extensions/replay.ts"]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3",
    "typebox": "^1.3.7",
    "vitest": "^4.1.9"
  }
}
